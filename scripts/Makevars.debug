# Compiler flags for memory profiling. Pointed at by R_MAKEVARS_USER, which R
# reads in place of ~/.R/Makevars.
#
# These are assignments, not "+=" on PKG_CXXFLAGS: R builds its compile line as
#   ALL_CXXFLAGS = $(PKG_CXXFLAGS) ... $(CXXFLAGS)
# so anything added to PKG_CXXFLAGS is followed by R's own -O2 and loses, since
# the last -O on the command line wins. Setting CXXFLAGS replaces it.
#
# -O0                       allocation sites map back to source exactly
# -g                        symbols and line numbers for ms_print
# -fno-omit-frame-pointer   reliable stack unwinding
# -fvisibility=default      keep symbols visible; R defaults to hidden
#
# -O0 is slow on template-heavy Eigen and TMB code, and Valgrind multiplies
# that. If a run is impractical, -Og keeps most of the speed and nearly all of
# the debuggability.
CXXFLAGS = -g -Og -fno-omit-frame-pointer -fvisibility=default
CFLAGS   = -g -Og -fno-omit-frame-pointer -fvisibility=default
CXX_VISIBILITY =
C_VISIBILITY   =
